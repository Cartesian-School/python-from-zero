{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cartesian locale routes v1",
  "type": "object",
  "required": [
    "schema_version",
    "pages"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "variant": {
      "type": "object",
      "required": [
        "path",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9/_-]+\\.html$"
        },
        "status": {
          "enum": [
            "untranslated",
            "translated",
            "reviewed",
            "approved",
            "stale"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "source",
        "variants"
      ],
      "additionalProperties": false,
      "properties": {
        "practice_id": {
          "type": "string",
          "pattern": "^[0-9]{2}-[0-9]{2}$"
        },
        "source": {
          "type": "object",
          "required": [
            "locale",
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "locale": {
              "const": "ru"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            },
            "dependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "variants": {
          "type": "object",
          "required": [
            "ru"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    }
  }
}
